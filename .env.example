PORT=4173
HOST=127.0.0.1
NODE_ENV=development
DATA_DIR=.data

# Set both values to enable the protected administrator login.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Local-only simulated checkout. Production deployments always disable this mode.
DEMO_PAYMENTS=true

# Create test keys in the Razorpay Dashboard. Keep the secret on the server.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Optional: set this in Razorpay Webhooks for payment.captured and payment.failed.
RAZORPAY_WEBHOOK_SECRET=
